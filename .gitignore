# Bulk / non-source (not version-worthy)
# recycle = 47M old zips + SSH-key zips; posts/_inbox = 95M raw packs;
# packs/packs-team = team archives containing SSH keys
recycle/
posts/_inbox/
live-bundle/
packs/
packs-team/

# Build artifacts / regenerable
*.zip
vendor/
node_modules/
*.log

# Secrets / keys (defense-in-depth)
*.pem
*.key
*_deploy
*_deploy.pub
id_rsa*
id_ed25519*
*-ssh.zip
.env
.env.*

# OS / editor cruft
.DS_Store
*.swp
*~

# coordinator: stray dumps/archives — never track
*.sqlite.bak.*
download-*.tar.gz
live-bundle/v2-layouts-bundle.json

# archive-poc per-box runtime — NOT version-controlled
# index.sqlite: rebuilt from Postgres by bin/backfill.php (<3min); README says "built index, not committed"
archive-poc/index.sqlite
# config.json: per-box presentational config; fresh box seeds from config.seed.json (deploy: cp -n)
archive-poc/config.json
